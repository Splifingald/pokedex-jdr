# Variables publiques (bundlées dans le JS — OK pour clés anon)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxx...
VITE_ADMIN_SECRET=TonMotDePasseAdmin
# Clé publique VAPID (Web Push) — générée avec `npx web-push generate-vapid-keys`
VITE_VAPID_PUBLIC_KEY=xxxxx...

# Variables SERVEUR uniquement → à saisir dans Netlify Dashboard > Environment Variables
# Ne jamais préfixer avec VITE_ sinon elles deviennent publiques !
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxx...
ADMIN_SECRET=TonMotDePasseAdmin
# Paire VAPID (Web Push) — mêmes valeurs que `npx web-push generate-vapid-keys`,
# VAPID_PUBLIC_KEY doit être identique à VITE_VAPID_PUBLIC_KEY ci-dessus
VAPID_PUBLIC_KEY=xxxxx...
VAPID_PRIVATE_KEY=xxxxx...
VAPID_SUBJECT=mailto:ton-email@example.com
